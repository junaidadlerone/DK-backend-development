# dk-assistant-chat — environment variables
# Production values are injected on Cloud Run (senior dev / GCP Secret Manager).
# For local dev, copy to .env and fill in.

PORT=8080

# ── Notion → Pinecone KB sync ────────────────────────────────────────────────
NOTION_TOKEN=                       # Notion internal-integration secret (ntn_…)
NOTION_DATABASE_ID=   # DK+ KB database
OPENAI_KEY=                         # OpenAI API key — embeddings only (text-embedding-3-small)
PINECONE_API_KEY=                   # Pinecone project API key
PINECONE_INDEX_NAME=

# ── Inngest (durable sync scheduling) ────────────────────────────────────────
INNGEST_SIGNING_KEY=                # signkey-prod-… (SDK reads this name automatically)
INNGEST_EVENT_KEY=                 # event key      (SDK reads this name automatically)

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SYNC_SECRET=                 # any long random string; guards POST /admin/sync

# ── Chat spine (§4 — added next; unused by the sync) ─────────────────────────
SUPABASE_URL=                   # https://xnflihspegizweqidvow.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FLOWISE_URL=
FLOWISE_FLOW_ID=
FLOWISE_API_KEY=
# Langfuse + LangSmith: configured IN the Flowise agentflow (flow config → Analytics),
# same as Kabuki's Nami agentflow. No observability keys needed on this service.
