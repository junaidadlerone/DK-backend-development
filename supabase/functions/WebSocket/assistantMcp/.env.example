# dk-assistant-mcp — environment variables
# Production values injected on Cloud Run (senior dev / GCP Secret Manager).
# Copy to .env for local dev.

PORT=8080

# DK+ Supabase project (same project the assistantChat service + edge functions use)
SUPABASE_URL=                       # https://xnflihspegizweqidvow.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # verifies the end-user JWT (auth.getUser)
SUPABASE_ANON_KEY=                  # sent as apikey on edge-function calls (callApi)
